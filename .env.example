# Rill environment variables (dev)
# Copy to .env and fill in values. .env is gitignored.

# --- Server ---
RILL_PORT=8080

# --- SurrealDB ---
# SURREAL_USER and SURREAL_PASS MUST be overridden in prod. docker-compose
# now fails fast if either is unset, so there's no silent fallback to root.
SURREAL_URL=ws://localhost:8000
SURREAL_USER=CHANGE_ME
SURREAL_PASS=CHANGE_ME
SURREAL_NS=rill
SURREAL_DB=rill

# --- Auth ---
# RILL_AUTH_MODE controls how humans authenticate to the web UI.
#   local = built-in login (default) — username + password, session cookies
#   sso   = trusted reverse proxy — passes identity via X-Forwarded-User header
# Bearer tokens are always active regardless of mode (for MCP agents and CLI).
RILL_AUTH_MODE=local

# SSO mode settings (only used when RILL_AUTH_MODE=sso):
# RILL_AUTH_PROXY_HEADER=X-Forwarded-User
# RILL_TRUSTED_PROXY_IPS=192.0.2.0/24,172.16.0.0/12
# Common proxy headers by vendor:
#   oauth2-proxy: X-Forwarded-User (default)
#   Authentik:    X-authentik-username
#   Cloudflare:   Cf-Access-Authenticated-User-Email
#   Caddy:        X-Forwarded-User (configurable)
#   Traefik:      X-Forwarded-User (configurable)

# --- Orient ---
# RILL_OWNER_ENTITY identifies the operator's own identity card so it lands
# first in orient's Identity section. Set to the owner's record id (matching
# folds in all of that entity's aliases automatically since aliases live on
# the record). Unset = no owner pinning; promoted persons sort purely by
# mention_count + last_seen.
# RILL_OWNER_ENTITY=person:your-handle

# --- LLM provider ---
# Rill talks to any OpenAI-compatible /v1/chat/completions and /v1/embeddings
# endpoint. Defaults are OpenRouter; override for OpenAI, Anthropic-via-OpenRouter,
# vLLM, LM Studio, Ollama (with the OpenAI-compat shim), etc.
#
# API key precedence: EMBEDDING_API_KEY/LLM_API_KEY → OPENROUTER_API_KEY → ~/.openrouter-key
# Base URL precedence: EMBEDDING_BASE_URL/LLM_BASE_URL → https://openrouter.ai/api/v1

# Shared (most common — same provider for both):
# LLM_API_KEY=sk-or-v1-...
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Or split (different providers for chat vs embeddings):
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1

# Models
# EXTRACTION_MODEL=deepseek/deepseek-v4-flash
# EMBEDDING_MODEL=openai/text-embedding-3-small

# --- Features ---
# RILL_DEDUP=true                # context dedup for extraction prompts
