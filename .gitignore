# Embedded SvelteKit bundle. Only the placeholder index.html is committed;
# Docker overwrites the directory with the real build during the image build,
# and local devs can copy frontend/build/* over the placeholder to test
# the embedded path against `go build`.
internal/server/webui/*
!internal/server/webui/index.html

# Environment
.env
.env.local
.env.*.local

# Logs
*.log

# Playwright
/test-results/
/playwright-report/
/playwright/.cache/

# Docker (dev)
docker-compose.override.yml

# SurrealDB data (local dev)
data/
data-snapshot*/
*.db
history.txt

# Local-only deployment artifacts and machine-named files
*.local.*
lab/
scripts/*.sh
# ...but the PII guard is a shippable, reusable tool — keep it tracked.
!scripts/pii-guard.sh
migrate
/migrate
rill-darwin-arm64
/rill-darwin-arm64
rill-macos-*
/rill-macos-amd64
/rill-macos-arm64

