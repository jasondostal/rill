docs/exec-plans/active/intentional-memory/

# Local agent + loop signal files
.pi/
.escalate
.complete
.ready
.stop

# Test corpus / evaluation data generated locally — may contain operator
# memories, project names, infra details. Regenerate locally; do not commit.
testdata/*-corpus/
testdata/*-pilot/
testdata/*-r[0-9]/
testdata/*-export-*.json

# Eval run artifacts: per-run corpus subsets are regenerated each run.
docs/exec-plans/active/extraction-quality/runs/*/corpus_subset.json

# Property-test failure repros (auto-generated, per-run)
internal/**/testdata/rapid/

# Bootstrap admin token written by rill serve on first boot — secret, ephemeral.
initial-admin-token

# Local-only docs — operator-specific notes, kept on disk, never committed.
docs/exec-plans/active/extraction-quality/runs/
docs/exec-plans/active/extraction-quality/inspiration.md
docs/exec-plans/active/extraction-quality/eval-dataset.json
docs/exec-plans/completed/OIDC_AND_WRAPUP.md
