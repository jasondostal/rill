docs/exec-plans/active/proxy-header-auth-bypass/
testdata/eval/

# Claude Code agent worktree management
.claude/

# Bootstrap admin token (per-deploy, gitignored already, but .v* backups too)
initial-admin-token.*

# Research / competitive analysis notes — kept local, not shared.
research/

# pii-guard: the real denylist is a PII index — it must NEVER be tracked.
# Only .pii-denylist.sample (the format reference) is committed.
.pii-denylist
pii-denylist

# Archives are opaque to the text PII guard — never commit them.
*.zip
*.tar
*.tgz
*.tar.gz
